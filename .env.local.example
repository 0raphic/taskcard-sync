# 复制成 .env.local 再填
PORT=8088
PB_URL=http://127.0.0.1:8090

# DeepSeek：文字结构化用；没有 key 时录入页会提示
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 能读图的模型名，配了才支持「上传照片识别」
DEEPSEEK_VISION_MODEL=

# 本地 PocketBase 超级管理员（seed 脚本会用它建表）
PB_ADMIN_EMAIL=admin@taskcard.local
PB_ADMIN_PASSWORD=taskcard12345
